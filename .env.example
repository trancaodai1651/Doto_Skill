# Sao chép thành .env (KHÔNG commit .env)
# Thư mục dữ liệu riêng cho dev
DOTO_DATA_DIR=.dev-data/data
# GitHub OAuth App client_id (Device Flow) — client_id không phải bí mật nhưng là cấu hình của chủ sở hữu
DOTO_GITHUB_CLIENT_ID=
# Test/CI: dùng kho bí mật trong bộ nhớ thay vì OS vault
# DOTO_SECRETS=memory
