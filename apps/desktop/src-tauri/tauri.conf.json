{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doto Skill",
  "version": "0.1.0",
  "identifier": "com.doto.skill",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Desktop + web server cục bộ: AI CLI, Skills, thư viện video",
    "longDescription": "Doto Skill quản lý nhiều nguồn AI Skills, cài đặt có xác nhận Google Antigravity CLI, OpenAI Codex CLI, Claude Code CLI và cloudflared, render video bằng FFmpeg và phục vụ thư viện video cho thiết bị khác qua trình duyệt.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/dist/": "web/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
