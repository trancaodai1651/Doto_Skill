{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doto Skill",
  "version": "0.2.0",
  "identifier": "com.doto.skill",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Doto Skill Studio — Dựng Video AI (Claude · Codex · Antigravity)",
        "width": 1460,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.desktop/app/": "app/",
      "../.desktop/node/": "node/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
